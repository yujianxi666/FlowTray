{
  "name": "flowtray",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "FlowTray 流转台 — 拖入即流转，用完即清理。基于 Tauri 2 的跨应用文件中转坞。",
  "author": "FlowTray",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "rust:build": "cargo build --release --manifest-path src-tauri/Cargo.toml --features custom-protocol",
    "app:dev": "vite build && cargo run --manifest-path src-tauri/Cargo.toml",
    "app:build": "pnpm build && pnpm rust:build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
