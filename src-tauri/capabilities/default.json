{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "FlowTray 悬浮窗所需的最小权限集合：事件监听与窗口自身操作。",
  "windows": ["shelf"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging"
  ]
}
